# Copy to .env (gitignored) and fill in real values. Never commit .env.

# Figma personal access token with read access to the target file.
FIGMA_ACCESS_TOKEN=

# From the frame URL: figma.com/design/<FIGMA_FILE_KEY>/...?node-id=<dash-separated>
FIGMA_FILE_KEY=bvMnEkqW7u3CHT5lGNs3lg
# Figma REST API wants node ids colon-separated, not dash-separated (178-35186 -> 178:35186).
FIGMA_NODE_ID=178:35186

# Provisioned before T1.7/T1.9 (LLM reduction, descriptions, matching signals).
ANTHROPIC_API_KEY=
