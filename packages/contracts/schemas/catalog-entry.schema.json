{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://ui-assembler-slice/contracts/catalog-entry.schema.json",
  "title": "CatalogEntry",
  "description": "One sprite or prefab asset, probed by the Unity Editor batch step (R17: Editor script is authoritative for render metadata).",
  "type": "array",
  "items": { "$ref": "#/definitions/catalogEntry" },
  "definitions": {
    "catalogEntry": {
      "type": "object",
      "required": ["id", "path", "type", "feature", "render", "thumbnail", "role", "interactive", "visual_description"],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string"
        },
        "path": {
          "type": "string",
          "description": "Asset path relative to the Unity project, e.g. Assets/Common/Prefabs/RedButton.prefab."
        },
        "type": {
          "type": "string",
          "enum": ["sprite", "prefab"]
        },
        "feature": {
          "type": "string",
          "description": "Feature folder this asset belongs to (single-feature retrieval scope for the slice, R11)."
        },
        "render": {
          "type": "object",
          "required": ["image_type", "border", "ppu", "ppu_multiplier", "native_size", "tint"],
          "additionalProperties": false,
          "description": "Render metadata read live via Unity's asset APIs (R14, R17).",
          "properties": {
            "image_type": {
              "type": "string",
              "enum": ["Simple", "Sliced", "Tiled", "Filled"],
              "description": "Mirrors UnityEngine.UI.Image.Type."
            },
            "border": {
              "type": "array",
              "items": { "type": "number" },
              "minItems": 4,
              "maxItems": 4,
              "description": "Sprite 9-slice border: [left, bottom, right, top]."
            },
            "ppu": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "ppu_multiplier": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "native_size": {
              "type": "object",
              "required": ["w", "h"],
              "additionalProperties": false,
              "properties": {
                "w": { "type": "number", "exclusiveMinimum": 0 },
                "h": { "type": "number", "exclusiveMinimum": 0 }
              }
            },
            "tint": {
              "type": ["string", "null"],
              "description": "Hex color applied to the Image/SpriteRenderer, or null if untinted."
            }
          }
        },
        "thumbnail": {
          "type": "string",
          "description": "Base64 data URI of the RENDERED asset (at canonical size, post 9-slice/tint), not the raw texture (R14)."
        },
        "role": {
          "type": "string",
          "description": "e.g. base, pressed, disabled — asset's role within its template family."
        },
        "interactive": {
          "type": "boolean"
        },
        "visual_description": {
          "type": "string",
          "description": "LLM-generated description, computed off the rendered thumbnail, not the raw asset."
        }
      }
    }
  }
}
